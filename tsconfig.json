{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "moduleDetection": "force",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@ui-sdk/core": ["./upstream/ui/packages/core/dist/index.d.ts"],
      "@ui-sdk/core/renderer": ["./upstream/ui/packages/core/dist/renderer.d.ts"],
      "@ui-sdk/core/button": ["./upstream/ui/packages/core/dist/components/button/button.d.ts"],
      "@ui-sdk/core/separator": [
        "./upstream/ui/packages/core/dist/components/separator/separator.d.ts"
      ],
      "@ui-sdk/core/toggle": ["./upstream/ui/packages/core/dist/components/toggle/toggle.d.ts"],
      "#dev": ["./upstream/ui/packages/core/dist/foundation/kernel/dev-stub.d.ts"]
    }
  },
  "include": ["packages", "fixtures", "scripts", "upstream/ui/tests/css.d.ts"]
}
